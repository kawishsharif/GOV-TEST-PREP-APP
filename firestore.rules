rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own progress: users/{their uid}/exams/{examId}
    match /users/{userId}/exams/{examId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'app', 'v'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
